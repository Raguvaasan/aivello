# Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# DO NOT COMMIT .env.local TO VERSION CONTROL.

# ================================
# Firebase (client-side, public by design)
# ================================
# Get these from Firebase console > Project settings > Your apps.
# The REACT_APP_ prefix is kept for compatibility (see envPrefix in vite.config.mts).
# Every REACT_APP_* / VITE_* variable is inlined into the PUBLIC JavaScript bundle.
# Firebase web config is safe to expose; access is enforced by firestore.rules.
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional: overrides the mode detected by Vite (development | production | test).
# REACT_APP_ENV=production

# ================================
# Server-only secrets (serverless functions in api/)
# ================================
# WARNING: never prefix a secret with REACT_APP_ or VITE_ - it would be shipped to
# every visitor's browser. These are read only by api/*.ts on Vercel.
#
# Remove.bg API key, used by api/remove-bg.ts
# Get from: https://www.remove.bg/users/sign_up
# In production set it in Vercel > Settings > Environment Variables.
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Firebase Web API key used by api/remove-bg.ts to verify ID tokens.
# Falls back to REACT_APP_FIREBASE_API_KEY when unset.
# FIREBASE_API_KEY=your_firebase_api_key_here
