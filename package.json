{
  "name": "aivello",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "docx": "^9.8.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.19.0",
    "framer-motion": "^14.0.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "react-qrcode-logo": "^4.1.0",
    "react-router-dom": "^7.18.4",
    "web-vitals": "^6.2.3"
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.js",
    "dev": "vite",
    "prestart": "node scripts/copy-pdf-worker.js",
    "start": "vite",
    "prebuild": "node scripts/copy-pdf-worker.js",
    "build": "vite build",
    "postbuild": "node scripts/stamp-sw-version.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src api --max-warnings 0",
    "lint:fix": "eslint src api --fix",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "audit:security": "npm audit --audit-level moderate",
    "precommit": "npm run lint && npm run type-check && npm test",
    "clean": "node -e \"const fs=require('fs');for(const p of ['build','coverage','node_modules/.vite'])fs.rmSync(p,{recursive:true,force:true})\"",
    "check:bundle": "node scripts/check-bundle-size.js",
    "verify": "npm run type-check && npm run lint && npm test && npm run build && npm run check:bundle"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "postcss-selector-parser": "^7.1.6"
  }
}
