{
  "name": "aivello",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@firebase/auth": "^1.10.8",
    "@loadable/component": "^5.15.3",
    "compromise": "^14.14.4",
    "compromise-numbers": "^1.4.0",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "firebase": "^11.10.0",
    "framer-motion": "^12.23.3",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.54",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-qrcode-logo": "^3.0.0",
    "react-router-dom": "^7.6.3",
    "sentiment": "^5.0.2",
    "web-vitals": "^5.3.0"
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.js",
    "dev": "vite",
    "prestart": "node scripts/copy-pdf-worker.js",
    "start": "vite",
    "prebuild": "node scripts/copy-pdf-worker.js",
    "build": "vite build",
    "postbuild": "node scripts/stamp-sw-version.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src api --max-warnings 0",
    "lint:fix": "eslint src api --fix",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "audit:security": "npm audit --audit-level moderate",
    "precommit": "npm run lint && npm run type-check && npm test",
    "clean": "node -e \"const fs=require('fs');for(const p of ['build','coverage','node_modules/.vite'])fs.rmSync(p,{recursive:true,force:true})\"",
    "check:bundle": "node scripts/check-bundle-size.js",
    "verify": "npm run type-check && npm run lint && npm test && npm run build && npm run check:bundle"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
